# ── Ma'lumotlar bazasi ────────────────────────────────────────────────────
# Ishlab chiqish (embedded PostgreSQL, `npm run db:up`):
DATABASE_URL="postgresql://crm:crm@127.0.0.1:5433/savdo_crm?schema=public"
#
# Production: owner bo'lmagan ilova roli (RLS uchun majburiy).
# DATABASE_URL="postgresql://savdo_app:PAROL@db-host:5432/savdo?schema=public&connection_limit=10"
# MIGRATE_DATABASE_URL="postgresql://owner:PAROL@db-host:5432/savdo?schema=public"

# ── Sessiya imzosi (kamida 32 belgi) ──────────────────────────────────────
# openssl rand -hex 32
AUTH_SECRET="dev-only-secret-change-me-in-production-0123456789abcdef"

# ── Ixtiyoriy ─────────────────────────────────────────────────────────────
# Telegram bot (6-bosqich): qarzdorlarga eslatma yuborish
# TELEGRAM_BOT_TOKEN="123456:AA..."
# NEXT_PUBLIC_APP_URL="https://erp.example.uz"
